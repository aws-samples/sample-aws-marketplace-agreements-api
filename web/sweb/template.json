    "ApiGatewayResourceAgreementId": {
      "Type": "AWS::ApiGateway::Resource",
      "Properties": {
        "RestApiId": { "Ref": "ApiGateway" },
        "ParentId": { "Ref": "ApiGatewayResourceAgreements" },
        "PathPart": "{agreementId}"
      }
    },

    "ApiGatewayResourceTerms": {
      "Type": "AWS::ApiGateway::Resource",
      "Properties": {
        "RestApiId": { "Ref": "ApiGateway" },
        "ParentId": { "Ref": "ApiGatewayResourceAgreementId" },
